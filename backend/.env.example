# Copy this file to .env. The real .env is ignored by Git.
FIREBASE_PROJECT_ID=replace-with-firebase-project-id

# Local emulator only. Uncomment while the Firestore emulator is running.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Keep blank until you intend to write to a live project.
# For live migration, set this to exactly the same value as FIREBASE_PROJECT_ID.
ALLOW_LIVE_MIGRATION=

# Authentication uses gcloud Application Default Credentials by default.
# If you must use a credential file, set its path here; never paste key JSON here.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/location/service-account.json
